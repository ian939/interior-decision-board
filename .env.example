# Local API
HOST=127.0.0.1
PORT=8787
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://YOUR_GITHUB_USER.github.io
PUBLIC_WEB_URL=http://localhost:5173
DATA_DIR=./data
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=20

# Required for the first startup. Remove these from the environment after the
# two users have been created; password hashes remain in SQLite.
OWNER_NAME=나
OWNER_PASSWORD=
PARTNER_NAME=배우자
PARTNER_PASSWORD=
SESSION_SECRET=

# Claude CLI. No model API key is used by the application.
CLAUDE_COMMAND=claude
CLAUDE_TIMEOUT_MS=60000
YT_DLP_COMMAND=yt-dlp
YT_DLP_TIMEOUT_MS=45000

# Optional Telegram long-polling listener
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
TELEGRAM_PARTNER_ID=

# GitHub Pages build
VITE_API_BASE_URL=http://127.0.0.1:8787/api
VITE_BASE_PATH=/
